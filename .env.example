# PostgreSQL connection — replace YOUR_PASSWORD with your local postgres password
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ssra_library?schema=public"

# Auth.js secret — generate with: npx auth secret   (or any long random string)
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_TRUST_HOST=true

# First admin account (created by `npm run db:seed`)
ADMIN_MOBILE="9935184537"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Satyadev Kumar"

# Number of seats created by the seed
SEAT_COUNT=60

# SMS for OTP: "console" (prints OTP in the server terminal) or "msg91"
SMS_PROVIDER="console"
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# Where uploaded files (e-book PDFs, images) are stored
STORAGE_DIR="./storage"
